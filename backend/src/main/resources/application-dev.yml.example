# ============================================================
# 本地开发环境配置模板
# 用法：复制本文件为 application-dev.yml，把 CHANGE_ME 换成真实密码
#   PowerShell: Copy-Item application-dev.yml.example application-dev.yml
# 真正的 application-dev.yml 已被 .gitignore 忽略，不会进 git
# ============================================================
spring:
  datasource:
    # MySQL 8 的驱动类名，注意是 com.mysql.cj.jdbc.Driver（多了 .cj）
    driver-class-name: com.mysql.cj.jdbc.Driver

    # 连接串各参数的作用：
    #   useUnicode=true&characterEncoding=utf8  —— 中文不乱码
    #   serverTimezone=Asia/Shanghai            —— 时区对齐，否则时间差 8 小时
    #   useSSL=false                            —— 本地开发不走 SSL，避免证书告警
    #   allowPublicKeyRetrieval=true            —— MySQL 8 默认密码插件需要
    url: "jdbc:mysql://localhost:3306/todolist_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"

    username: root
    password: "CHANGE_ME"
